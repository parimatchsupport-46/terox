rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==========================================================================
       TEROX FIRESTORE RULES
       --------------------------------------------------------------------------
       Data is stored in a single collection called "data".
       Each document is keyed by the localStorage key name:
         - terox.users.v1      → user roster (managed by admin panel)
         - terox.chats.v1      → chat threads and messages
         - terox.profile.v1    → current user profile
         - terox.prefs.v1      → user preferences
         - terox.payreq.v1     → payment requests (user creates, admin verifies)

       To tighten security later, replace the rules below with role-based checks.
       For example, to restrict writes to admins only:

         allow write: if request.auth != null && request.auth.token.admin == true;

       Or to restrict chat writes to the owner of the thread:

         allow write: if request.auth != null && request.auth.uid == resource.data.uid;

       HOW TO UPDATE RULES:
       1. Edit this file (firestore.rules)
       2. Copy the contents
       3. Go to Firebase Console → Firestore Database → Rules tab
       4. Paste the new rules and click Publish
       ========================================================================== */

    // Public read access for all data
    match /data/{key} {
      allow read: if true;
      allow write: if true;
    }
  }
}
